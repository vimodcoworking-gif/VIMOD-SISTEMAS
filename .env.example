# Copia este archivo como .env y coloca tus valores.
# Usa la MISMA base de datos que el Panel administrador.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/vimod?retryWrites=true&w=majority
# Texto largo y aleatorio para firmar las sesiones de los clientes
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# Inicio de sesión con Google (opcional). Client ID de tipo "Aplicación web" de Google Cloud.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
PORT=3000
